{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scuole-vicine-api",
  "account_id": "85f18a9dd2f084a555e2ede5472c1e47",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scuole-vicine",
      "database_id": "65e31a91-dfdd-4ce7-9cd7-7649ac56dd58",
      "migrations_dir": "migrations",
      "jurisdiction": "eu"
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "REPORT_EMAIL",
      "destination_address": "emanuele@cardinali.studio"
    }
  ],
  "vars": {
    "REPORT_FROM": "scuole-vicine@notifiche.cardinali.studio"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
