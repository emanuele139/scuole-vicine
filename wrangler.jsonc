{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scuole-milano",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "force-trailing-slash", "not_found_handling": "404-page" },
  "d1_databases": [{ "binding": "DB", "database_name": "scuole-milano-shared", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 180, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
