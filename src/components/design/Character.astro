---
interface Props { kind?: 'flower' | 'arch' | 'spark' | 'book'; color?: string; class?: string }
const { kind = 'flower', color = '#F56A47', class: className = '' } = Astro.props;
---
<svg class:list={['character', className]} viewBox="0 0 240 240" fill="none" aria-hidden="true" focusable="false">
  {kind === 'flower' && <g fill={color}>
    <ellipse cx="120" cy="67" rx="38" ry="57"/><ellipse cx="120" cy="173" rx="38" ry="57"/>
    <ellipse cx="67" cy="120" rx="57" ry="38"/><ellipse cx="173" cy="120" rx="57" ry="38"/>
    <ellipse cx="82" cy="82" rx="36" ry="53" transform="rotate(-45 82 82)"/><ellipse cx="158" cy="158" rx="36" ry="53" transform="rotate(-45 158 158)"/>
    <ellipse cx="82" cy="158" rx="36" ry="53" transform="rotate(45 82 158)"/><ellipse cx="158" cy="82" rx="36" ry="53" transform="rotate(45 158 82)"/>
    <circle cx="120" cy="120" r="66"/>
  </g>}
  {kind === 'arch' && <path d="M23 217V109a97 97 0 0 1 194 0v108H23Z" fill={color}/>}
  {kind === 'spark' && <path d="m120 8 23 54 48-32-10 57 57 3-43 38 39 43-57-3 4 57-44-36-29 49-13-56-52 24 20-54-56-11 49-29-34-46 57 6L120 8Z" fill={color}/>}
  {kind === 'book' && <><path d="M21 45c36-15 72-9 99 16 27-25 63-31 99-16v151c-38-12-69-7-99 16-30-23-61-28-99-16V45Z" fill={color}/><path d="M120 63v143" stroke="#29271F" stroke-width="3"/></>}
  <g class="character-eyes">
    <ellipse cx="97" cy="108" rx="12" ry="18" fill="#FFFDF5"/><ellipse cx="139" cy="108" rx="12" ry="18" fill="#FFFDF5"/>
    <ellipse cx="100" cy="111" rx="5.5" ry="9" fill="#29271F"/><ellipse cx="142" cy="111" rx="5.5" ry="9" fill="#29271F"/>
  </g>
  <path d="M101 140c10 12 24 12 34 0" stroke="#29271F" stroke-width="4" stroke-linecap="round"/>
</svg>
