---
interface Props { count?: number }
const { count } = Astro.props;
---
<details class="source-disclosure">
  <summary>Consulta le fonti{count !== undefined && <span class="source-count"> · {count}</span>}</summary>
  <div class="source-content"><slot/></div>
</details>
<script>
  function openSources() {
    const details = document.querySelector<HTMLDetailsElement>('#fonti .source-disclosure');
    if (details) details.open = true;
  }
  document.querySelectorAll<HTMLAnchorElement>('a[href="#fonti"]').forEach(link => link.addEventListener('click', openSources));
  if (window.location.hash === '#fonti') openSources();
</script>
<style>
  .source-disclosure { border-block: 1px solid var(--line, #deded5); margin-block: 1rem; }
  summary { padding: .85rem .25rem; min-height: 44px; cursor: pointer; font-size: .95rem; font-weight: 600; }
  summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; border-radius: 3px; }
  .source-count { font-weight: 400; }
  .source-content { padding: .25rem .25rem 1rem; overflow-wrap: anywhere; }
  @media print { .source-content { display: block; } }
</style>
