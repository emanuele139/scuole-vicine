---
import PageIntro from '../components/PageIntro.astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { schools, schoolHref } from '../lib/catalog';
import { collectAgendaEvents } from '../lib/agenda-events';
const events = collectAgendaEvents(schools);
const months = [...new Set(events.map(e => e.date.slice(0,7)))];
const municipalities = [...new Set(events.flatMap(e => e.schools.flatMap(s => s.municipality ? [s.municipality] : [])))].sort((a,b) => a-b);
const monthLabel = (month: string) => new Date(month+'-15T12:00:00').toLocaleDateString('it-IT',{month:'long',year:'numeric'});
const researchDate = schools.flatMap(s => s.research ? [s.research.checkedAt] : []).sort().at(-1);
---
<Layout title="Open day" active="agenda">
  <PageIntro accent="visite" title="Open day e visite" eyebrow="CONOSCERE, PRIMA DI SCEGLIERE" description="Le prossime occasioni per incontrare le scuole. Date, sedi e prenotazioni, con le fonti a portata di mano." tone="sole" character="flower"/>
  <div class="agenda-tools"><div class="agenda-filters"><button class="btn btn-small" id="all-events" aria-pressed="true">Tutte le scuole</button><button class="btn btn-small" id="saved-events" aria-pressed="false"><Icon name="heart" size={15}/>Solo salvate</button></div><label><input type="checkbox" id="past-events"/> Mostra eventi passati</label><button class="btn btn-small" id="export-events"><Icon name="download" size={15}/>Scarica calendario</button></div>
  <div class="agenda-extra-filters"><label for="event-month">Quando<select id="event-month"><option value="">Tutti i mesi</option>{months.map(month=><option value={month}>{monthLabel(month)}</option>)}</select></label><label for="event-municipality">Dove<select id="event-municipality"><option value="">Tutti i Municipi</option>{municipalities.map(m=><option value={m}>Municipio {m}</option>)}</select></label></div>
  <h2 class="agenda-results-count" id="agenda-results-count" role="status"></h2>
  <div class="event-list">{months.map(month=><section class="event-month" data-event-month={month}><h2 class="event-month-title">{monthLabel(month)}</h2>{events.filter(e=>e.date.startsWith(month)).map(event=>{const d=new Date(event.date+'T12:00:00+01:00');return <article class="event-card" data-event-id={event.id} data-event-school={event.school.id} data-event-schools={event.schools.map(s=>s.id).join(",")} data-event-date={event.date}><div class="event-day"><span>{d.toLocaleDateString('it-IT',{weekday:'short'})}</span><strong>{d.getDate()}</strong><small>{d.toLocaleDateString('it-IT',{month:'short'})}</small></div><div class="event-content"><span class="badge badge-outline">{[...new Set(event.schools.map(s=>s.management))].join(' / ')} · {[...new Set(event.schools.map(s=>s.educationStage === 'nursery' ? '0–3' : '3–6'))].join(' e ')}</span><h3>{event.schools.map((s,i)=><>{i > 0 && " / "}<a href={schoolHref(s)}>{s.name}</a></>)}</h3><p><Icon name="clock" size={15}/>{event.time}<span>·</span>{event.location||event.school.address}</p>{event.booking&&<p class="event-booking">{event.booking}</p>}</div><div class="event-actions"><a class="btn btn-small" href={event.source} target="_blank" rel="noopener noreferrer">Fonte e prenotazione<Icon name="external" size={14}/></a><button class="btn-text" data-download-event={event.id}><Icon name="calendar" size={15}/>Aggiungi al calendario</button></div></article>;})}</section>)}</div>
  <div class="empty-state" id="no-events" hidden><Icon name="calendar" size={30}/><h2>Nessun incontro corrisponde ai filtri scelti</h2><p>Prova a cambiare i filtri. Per le scuole che ti interessano, puoi controllare anche i siti ufficiali: alcune date potrebbero non essere ancora pubblicate.</p><a href="/famiglia/" class="btn">Le tue scuole<Icon name="arrow-right" size={15}/></a></div>
  <p class="notice agenda-notice">La raccolta comprende {events.length} appuntamenti, inclusi quelli passati. Quando un incontro riguarda sia il nido sia la scuola dell’infanzia, lo trovi una sola volta, con i collegamenti a entrambi i servizi.{researchDate && <> Ricerca aggiornata al {new Date(researchDate+'T12:00:00').toLocaleDateString('it-IT')}.</>} La ricerca comprende servizi 0–3 e scuole dell’infanzia 3–6. Le visite su richiesta e gli appuntamenti senza anno o orario certo sono indicati nelle schede delle scuole, ma non vengono inseriti nel calendario. Molte sedi non pubblicano date complete: se qui non trovi un appuntamento, la scuola potrebbe comunque organizzare incontri o visite.</p>
  <script src="../scripts/agenda.ts"></script>
</Layout>
