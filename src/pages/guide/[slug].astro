---
import PageIntro from '../../components/PageIntro.astro';
import Layout from '../../layouts/Layout.astro';
import { project } from '../../data/project';
import data from '../../data/guides.json';
export function getStaticPaths(){return data.guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide}=Astro.props;
const nursery=guide.stage==='nursery';
const nurseryRows=[['Residenti · ISEE fino a 6.500,00 €','0 €','0 €'],['6.500,01–12.500,00 €','111,30 €','55,65 €'],['12.500,01–27.000,00 €','250,60 €','125,30 €'],['Oltre 27.000 € o ISEE assente','502,20 €','251,10 €'],['Non residenti a Milano','669,35 €','334,68 €']];
const sources:Record<string,{title:string;url:string;note:string}>=data.sources;
const rows=[['Fino a 2.000,00 €','Gratuita'],['2.000,01–4.000,00 €','259,20 €'],['4.000,01–6.500,00 €','356,40 €'],['6.500,01–12.500,00 €','496,80 €'],['12.500,01–27.000,00 €','653,40 €'],['Oltre 27.000 € o dati ISEE assenti','734,40 €']];
---
<Layout title={guide.title} active="guide" description={guide.intro}>
<PageIntro title={guide.title} eyebrow={nursery?"NIDI E SERVIZI · 0–3 ANNI":"SCUOLA DELL’INFANZIA · 3–6 ANNI"} description={guide.intro} tone="rosa" character="book" backHref="/guide/" backLabel="Tutte le guide"/>
<p class="guide-byline">Una guida di <a href={project.authorUrl || '/progetto/#autore'} rel="author">{project.author}</a> per {project.name}. <a href="/metodo/">Metodo e fonti del progetto</a>.</p>
<p class="notice">Informazioni verificate il 16 novembre 2026. Le regole amministrative del 2026/27 devono essere riconfermate per il 2027/28. Seleziona il numero accanto a una risposta per leggere le fonti e come le abbiamo controllate.</p>
<div class="reading-layout"><div class="guide-body"><nav class="guide-index" aria-label="In questa guida"><h2>In questa guida</h2><ol>{guide.questions.map((q,i)=><li><a href={`#${q.id}`}><span class="guide-index-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{q.title}</span><span class="guide-index-arrow" aria-hidden="true">↘</span></a></li>)}</ol></nav>
{guide.questions.map((q,i)=><section class="answer" id={q.id}><h2><span class="answer-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{q.title}</span></h2>{q.text.split("\n\n").map((paragraph,paragraphIndex,paragraphs)=><p>{paragraph}{paragraphIndex===paragraphs.length-1&&<sup><a href={`#fonte-${q.id}`} class="source-trigger" data-source={q.id} aria-label={`Leggi le fonti e la verifica: ${q.title}`} aria-controls={`fonte-${q.id}`} aria-expanded="false">[{i+1}]</a></sup>}</p>)}{q.id==='rette03'&&<div class="table-scroll"><table class="data-table"><caption>Posti assegnati dal Comune · quote mensili 2026/27 in euro · importi da riconfermare per il 2027/28</caption><thead><tr><th scope="col">Residenza e fascia ISEE</th><th scope="col">Nido</th><th scope="col">Primavera</th></tr></thead><tbody>{nurseryRows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>}{q.id==='fasce'&&<div class="table-scroll"><table class="data-table"><caption>Mensa della scuola dell’infanzia · residenti a Milano · importi delle fonti consultate, da riconfermare per il 2027/28</caption><thead><tr><th scope="col">ISEE</th><th scope="col">Quota annua</th></tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table></div>}</section>)}
<div class="guide-actions"><a class="btn" href={nursery?"/nidi/":"/scuole-infanzia/"}>{nursery?"Elenco dei servizi 0–3":"Elenco delle scuole 3–6"}</a><a class="btn btn-primary" href={nursery?"/?fascia=nursery":"/?fascia=preschool"}>{nursery?"Cerca i servizi 0–3":"Cerca le scuole 3–6"}</a><a class="btn" href="/agenda/">Consulta gli open day</a><a class="btn" href="/famiglia/">Le tue scuole</a></div></div>
<aside class="source-sidebar" aria-label="Fonti e verifiche"><div class="source-intro"><p class="eyebrow">Le fonti, vicino al testo</p><p>Seleziona il numero accanto alla risposta per leggere i documenti consultati, il confronto tra le fonti e le informazioni ancora da verificare.</p></div>{guide.questions.map((q,i)=><section class="source-note" id={`fonte-${q.id}`} tabindex="-1" aria-labelledby={`titolo-fonte-${q.id}`}><div class="source-heading"><span class="eyebrow">Fonte {i+1}</span><button type="button" class="source-close" aria-label="Chiudi le fonti della risposta">Chiudi ×</button></div><h2 id={`titolo-fonte-${q.id}`}>{q.title}</h2><p class="source-check">{q.check}</p><ol>{q.refs.map(key=><li><a href={sources[key].url} target="_blank" rel="noopener noreferrer">{sources[key].title} ↗</a><p>{sources[key].note}</p></li>)}</ol><p class="source-date">Fonti consultate il 16 novembre 2026</p></section>)}</aside></div>
<nav class="other-guides" aria-label="Altre guide">{data.guides.filter(g=>g.slug!==guide.slug).map(g=><a href={`/guide/${g.slug}/`}>{g.title} →</a>)}</nav>
</Layout>
<noscript><style is:inline>.source-note{display:block;max-height:none}.source-close{display:none}</style></noscript>
<script>
const triggers = document.querySelectorAll<HTMLAnchorElement>('.source-trigger');
const sidebar = document.querySelector<HTMLElement>('.source-sidebar');
const compact = window.matchMedia('(max-width: 1023px)');
let lastTrigger: HTMLAnchorElement | null = null;
function placeNotes() {
  const focused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
  const restoreFocus = !!focused?.closest('.source-note');
  triggers.forEach(trigger => {
    const note = document.getElementById(`fonte-${trigger.dataset.source}`);
    const paragraph = trigger.closest('p');
    if (!note || !paragraph || !sidebar) return;
    if (compact.matches) paragraph.after(note);
    else sidebar.append(note);
  });
  if (restoreFocus) focused?.focus({ preventScroll: true });
}
placeNotes();
compact.addEventListener('change', placeNotes);
function closeNotes(returnToText = false) {
  document.querySelectorAll('.source-note.is-open').forEach(note => note.classList.remove('is-open'));
  triggers.forEach(trigger => trigger.setAttribute('aria-expanded', 'false'));
  if (returnToText && lastTrigger) {
    lastTrigger.focus({ preventScroll: true });
    lastTrigger.scrollIntoView({ block: 'nearest', behavior: 'instant' });
  }
}
triggers.forEach(trigger => trigger.addEventListener('click', event => {
  event.preventDefault();
  const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
  const fromKeyboard = trigger.matches(':focus-visible');
  closeNotes();
  lastTrigger = trigger;
  if (wasOpen) return;
  const note = document.getElementById(`fonte-${trigger.dataset.source}`);
  if (note) {
    note.classList.add('is-open');
    note.scrollTop = 0;
    trigger.setAttribute('aria-expanded', 'true');
    note.focus({ preventScroll: true });
    if (compact.matches && fromKeyboard) note.scrollIntoView({ block: 'start', behavior: 'instant' });
  }
}));
document.querySelectorAll('.source-close').forEach(button => button.addEventListener('click', () => closeNotes(true)));
document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && document.querySelector('.source-note.is-open')) closeNotes(true);
});
</script>
