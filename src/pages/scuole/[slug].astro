---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import SchoolMap from '../../components/SchoolMap.astro';
import FieldEvidence from '../../components/FieldEvidence.astro';
import SourceDisclosure from '../../components/SourceDisclosure.astro';
import { guides } from '../../data/guides.json';
import { stageCollections } from '../../lib/seo';
import { catalogText, catalogParagraphs } from '../../lib/catalog-copy';
import { schools, type School } from '../../lib/catalog';
export function getStaticPaths() { return schools.map(school => ({ params: { slug: school.slug }, props: { school } })); }
interface Props { school: School }
const { school } = Astro.props;
const isNursery = school.educationStage === 'nursery';
const managementLabel = isNursery && school.management === 'Comunale' && school.accessMode.toLowerCase().includes('appalto') ? 'Comunale · in appalto' : school.management;
const route = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(school.address + ', Milano');
const municipalityLabel = school.municipality ? `Municipio ${school.municipality}` : null;
const place = [school.zone !== municipalityLabel ? school.zone : null, municipalityLabel].filter(Boolean).join(' · ');
const sourceMap = new Map(school.sources.map(source => [source.url, source]));
// Keep every per-field reference available in the shared source section.
for (const evidence of Object.values(school.research?.fieldEvidence || {})) {
  for (const url of evidence.sourceUrls) if (!sourceMap.has(url)) sourceMap.set(url, { url, label: 'Fonte dell’approfondimento' });
}
for (const event of school.events) if (!sourceMap.has(event.source)) sourceMap.set(event.source, { url: event.source, label: 'Avviso della scuola' });
const uniqueSources = [...sourceMap.values()];
const dateLabel = (value: string) => new Date(value + (value.length === 10 ? 'T12:00:00' : '')).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title={school.name} active="cerca" description={`${school.name}, ${school.address}. Orari, costi, open day e fonti per scegliere ${isNursery ? "un servizio 0–3" : "la scuola dell’infanzia"} a Milano.`}>
  <div class="school-page">
    {school.status === 'historical' && <aside class="notice school-archive"><strong>Le fonti documentano la chiusura della scuola.</strong> Conserviamo la scheda per mostrarti i documenti consultati. Non abbiamo confermato un’eventuale riapertura o l’offerta attuale.</aside>}
    <a class="back-link" href="/" data-search-return><Icon name="arrow-left" size={17} /><span data-return-label>Tutte le scuole</span></a>
    <header class="school-hero">
      <div><div class="school-labels"><span class="badge">{managementLabel}</span><span>{school.serviceType} · {school.ageRange}</span><span>{place || 'Milano'}</span></div><h1>{school.name}</h1><p class="school-address"><Icon name="location" />{school.address}, Milano</p></div>
      <div class="school-primary-actions"><button class="btn btn-primary" data-save-school={school.id} aria-pressed="false"><Icon name="heart" /><span class="save-label" data-save-label>Salva scuola</span></button><button class="btn btn-secondary" data-compare-school={school.id} aria-pressed="false"><Icon name="grid" /><span data-compare-label>Confronta</span></button><button type="button" class="btn btn-secondary" data-report-school={school.id} data-report-name={school.name} aria-haspopup="dialog" aria-label={`Segnala un problema con ${school.name}`}><Icon name="flag" size={16} /><span>Segnala</span></button></div>
    </header>
    <div class="school-data-note"><Icon name="info" size={18} /><p>{school.research ? <>Ultimo controllo: {dateLabel(school.research.checkedAt)}.</> : <>Catalogo {school.catalogYear}.</>} Posti e condizioni per il 2027/28 vanno confermati con la scuola. <a href="#fonti">Fonti e periodo dei dati ↓</a></p></div>
    {school.warnings.length > 0 && <aside class="school-warnings" aria-label="Informazioni da verificare"><strong>Prima di organizzare una visita</strong><ul>{school.warnings.map(warning => <li>{catalogText(warning)}</li>)}</ul></aside>}
    <nav class="school-section-nav" aria-label="In questa scheda"><a href="#in-breve" class="active">In breve</a>{school.status !== "historical" && <><a href="#giornata">La giornata</a><a href="#servizi">Servizi e spazi</a><a href="#costi">Costi</a><a href="#visite">Visite</a></>}<a href="#dove">Dove si trova</a><a href="#fonti">Fonti</a></nav><div class="school-layout">
      <div class="school-details">
        <section class="detail-section" id="in-breve"><p class="eyebrow">{isNursery ? "Il servizio 0–3" : "La scuola"}</p><h2>Una prima conoscenza</h2>{catalogParagraphs(school.description || 'Questa sede compare nel catalogo ufficiale. Per conoscere il progetto educativo e i servizi, puoi contattare la scuola.').map(paragraph => <p>{paragraph}</p>)}<dl class="facts-list"><div><dt>Servizio</dt><dd>{school.serviceType}</dd></div><div><dt>Età</dt><dd>{school.ageRange}</dd></div><div><dt>{isNursery ? 'Servizio e gestione' : 'Gestione'}</dt><dd>{managementLabel}</dd></div>{school.operator && <div><dt>Gestore</dt><dd>{school.operator}</dd></div>}<div><dt>Accesso</dt><dd>{catalogText(school.accessMode)}</dd></div><div><dt>{isNursery ? 'Presenza negli elenchi ufficiali' : 'Riconoscimento'}</dt><dd>{catalogText(school.recognition) || 'Il riconoscimento resta da verificare.'}</dd></div>{school.code && <div><dt>Codice scuola</dt><dd>{school.code}</dd></div>}</dl></section>
        {school.status !== 'historical' && <><section class="detail-section" id="giornata"><p class="eyebrow">La giornata</p><h2>Orari e servizi</h2>{school.hours ? catalogParagraphs(school.hours).map(paragraph => <p>{paragraph}</p>) : <p class="unknown-value">Non abbiamo ancora verificato gli orari di questa sede. La scuola può indicarti quelli aggiornati.</p>}<FieldEvidence evidence={school.research?.fieldEvidence.hours}/><p class="detail-prompt">Durante il colloquio puoi chiedere gli orari di ingresso e uscita, le condizioni per il prolungamento e come vengono organizzati riposo, ambientamento e servizio estivo.</p></section>
        <section class="detail-section" id="servizi"><h2>Servizi e spazi</h2>{school.services?.length ? <ul class="school-services">{school.services.map(service => <li>{catalogText(service)}</li>)}</ul> : <p class="unknown-value">Nelle fonti consultate non abbiamo trovato una descrizione dei servizi e degli spazi. Durante il colloquio puoi approfondire riposo, mensa, spazi esterni e prolungamento.</p>}<FieldEvidence evidence={school.research?.fieldEvidence.services}/></section>
        <section class="detail-section" id="costi"><p class="eyebrow">Il budget</p><h2>Costi</h2>{school.cost ? catalogParagraphs(school.cost).map(paragraph => <p>{paragraph}</p>) : <p class="unknown-value">Non abbiamo ancora verificato gli importi per questa sede. Per confrontare i costi, chiedi un preventivo che distingua iscrizione, frequenza, mensa e servizi aggiuntivi.</p>}<FieldEvidence evidence={school.research?.fieldEvidence.cost}/><a class="detail-link" href="/iscrizioni/#costi">Come leggere un preventivo completo <Icon name="arrow-right" size={17} /></a></section>
        <section class="detail-section" id="visite"><p class="eyebrow">Da vedere insieme</p><h2>Open day e visite</h2>{school.openDay ? catalogParagraphs(school.openDay).map(paragraph => <p>{paragraph}</p>) : <p class="unknown-value">Non abbiamo una data verificata per questa sede. Puoi contattare la scuola per sapere se sono previste visite.</p>}{school.events.length > 0 && <div class="school-events">{school.events.map(event => <article class="school-event"><Icon name="calendar" /><div><h3>{dateLabel(event.date)}</h3><p>{event.time}{event.location && <> · {event.location}</>}</p>{event.booking && <p>{catalogText(event.booking)}</p>}<a href={event.source} target="_blank" rel="noopener noreferrer">Avviso della scuola <Icon name="external" size={14} /></a></div></article>)}</div>}<FieldEvidence evidence={school.research?.fieldEvidence.openDay}/><p class="detail-prompt">Prima della visita, controlla l’avviso della scuola: data, sede e modalità di accesso possono cambiare.</p></section>
        </>}
        <SchoolMap school={school}/><section class="detail-section sources-section" id="fonti"><h2>Fonti</h2><SourceDisclosure count={uniqueSources.length}><p class="source-method">I dati identificativi provengono dal catalogo {school.catalogYear}. {school.research ? 'Per ciascuna voce indichiamo l’anno a cui si riferiscono le informazioni.' : school.detailYear ? `Le informazioni di dettaglio si riferiscono al ${school.detailYear}.` : ''} Le informazioni degli anni precedenti restano da confermare per il 2027/28. {!school.research && !isNursery && school.enriched && <>I dettagli sono stati raccolti il 15 novembre 2026.</>} {school.verifiedAt && <>L’identità della sede è stata confrontata con gli elenchi il {dateLabel(school.verifiedAt)}.</>}</p>{school.sourceIds.cudes && <p class="source-method">Codice CUDES del registro regionale: {school.sourceIds.cudes}.</p>}<ul class="source-list">{uniqueSources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer"><span>{source.label}{source.year && <small>{source.year}</small>}</span><Icon name="external" size={16} /></a></li>)}</ul><a class="detail-link" href="/metodo/">Come verifichiamo le informazioni <Icon name="arrow-right" size={17} /></a></SourceDisclosure></section>
      </div>
      <aside class="school-sidebar">
        <section class="contact-panel"><p class="eyebrow">Il prossimo passo</p><h2>{school.status === 'historical' ? 'Documenti della sede' : 'Parla con la scuola'}</h2><p>{school.status === 'historical' ? 'Il documento del Comune conferma la chiusura. Non abbiamo verificato l’offerta attuale.' : 'Prima di decidere, parla con la scuola dei servizi che contano per la tua famiglia.'}</p><div class="contact-links">{!school.url && !school.officialPage && <p class="official-link-missing">Non abbiamo identificato il sito ufficiale di questa sede. In fondo alla scheda trovi i documenti consultati.</p>}{school.officialPage && school.officialPage !== school.url && <a class="btn btn-secondary" href={school.officialPage} target="_blank" rel="noopener noreferrer">Pagina ufficiale della sede <Icon name="external" size={16}/></a>}{school.url && <a class="btn btn-secondary" href={school.url} target="_blank" rel="noopener noreferrer">{school.status === 'historical' ? 'Documento sulla sede' : school.url.includes('comune.milano.it') && school.officialPage !== school.url ? 'Sito del Comune' : school.officialPage && school.officialPage !== school.url ? 'Sito della scuola' : 'Pagina ufficiale'} <Icon name="external" size={16} /></a>}{school.status !== 'historical' && <a class="btn btn-secondary" href={route} target="_blank" rel="noopener noreferrer"><Icon name="location" size={17} />Calcola il percorso</a>}{school.phone && <a href={'tel:' + school.phone.split('/')[0].replace(/[^+\d]/g, '')}>{school.phone}</a>}{school.email && <a href={'mailto:' + school.email}>{school.email}</a>}</div></section>
        {school.status !== 'historical' && <section class="family-panel"><Icon name="users" size={25} /><h2>Le tue impressioni</h2><p>Salva la scuola per raccogliere domande, appunti e punti di vista da confrontare in famiglia.</p><a href="/famiglia/" class="detail-link">Apri il taccuino <Icon name="arrow-right" size={17} /></a></section>}
      </aside>
    </div>
    <section class="prose"><h2>Continua la ricerca</h2><p><a href={stageCollections.find(c => c.stage === school.educationStage)!.path}>{isNursery ? 'Tutti i nidi e servizi 0–3 a Milano' : 'Tutte le scuole dell’infanzia a Milano'}</a>{school.municipality && <> · <a href={`/municipi/${school.municipality}/`}>Nidi e scuole nel Municipio {school.municipality}</a></>}</p><h3>Per preparare la scelta</h3><ul>{guides.filter(g => g.stage === school.educationStage).map(g => <li><a href={`/guide/${g.slug}/`}>{g.title}</a></li>)}</ul></section>
  </div>
</Layout>
