---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DetourScene from '../components/design/DetourScene.astro';
import '../styles/not-found.css';
---
<Layout title="Pagina non trovata" description="Questa pagina non c’è o ha cambiato indirizzo. Riparti dalla ricerca di nidi e scuole dell’infanzia a Milano, dalle guide o dagli open day." active="" noindex>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-copy">
      <p class="eyebrow"><span>404</span> PAGINA NON TROVATA</p>
      <h1 id="not-found-title">Qui la strada<br/>fa una <span>curva.</span></h1>
      <p class="not-found-description">Questa pagina non c’è o ha cambiato indirizzo. Le scuole, però, sono da questa parte.</p>
      <a class="btn btn-primary not-found-primary" href="/" data-not-found-search><Icon name="search" size={19}/><span data-not-found-label>Torna alla ricerca</span><Icon name="arrow-right" size={20}/></a>
      <p class="not-found-reassurance">Un piccolo giro. Poi si riparte.</p>
    </div>
    <div class="not-found-art"><DetourScene/><span class="not-found-art-note" aria-hidden="true">C’È SEMPRE UN ALTRO INIZIO <span>↗</span></span></div>
  </section>
  <nav class="not-found-paths" aria-label="Altri punti da cui ripartire">
    <p>Oppure, continua da qui</p>
    <a href="/guide/"><span class="not-found-number">01</span><span><strong>Come scegliere</strong><small>Risposte ai dubbi, un passo alla volta.</small></span><Icon name="arrow-right" size={21}/></a>
    <a href="/agenda/"><span class="not-found-number">02</span><span><strong>Open day e visite</strong><small>Le occasioni per conoscere le scuole.</small></span><Icon name="arrow-right" size={21}/></a>
    <a href="/famiglia/"><span class="not-found-number">03</span><span><strong>Le tue scuole</strong><small>La tua selezione e i tuoi appunti.</small></span><Icon name="arrow-right" size={21}/></a>
  </nav>
</Layout>
<script>
  import { readSearchSession, tabSearchStorage } from '../lib/search-session';
  const previous = readSearchSession(tabSearchStorage());
  const link = document.querySelector<HTMLAnchorElement>('[data-not-found-search]');
  if (link && previous) {
    link.href = `${previous.url}#riprendi`;
    link.querySelector('[data-not-found-label]')!.textContent = 'Riprendi la ricerca';
    link.setAttribute('aria-label', 'Riprendi la ricerca con i filtri e la posizione precedenti');
  }
</script>
