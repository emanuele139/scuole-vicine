---
import PageIntro from '../components/PageIntro.astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import EmptyState from '../components/EmptyState.astro';
import { schools, schoolHref } from '../lib/catalog';
const data = schools.map(school => ({ id: school.id, educationStage: school.educationStage, serviceType: school.serviceType, ageRange: school.ageRange, accessMode: school.accessMode, operator: school.operator, name: school.name, address: school.address, zone: school.zone, municipality: school.municipality, management: school.management, recognition: school.recognition, hours: school.hours, cost: school.cost, services: school.services || [], openDay: school.openDay, description: school.description, catalogYear: school.catalogYear, detailYear: school.detailYear, enriched: school.enriched, verifiedAt: school.verifiedAt, research: school.research, warnings: school.warnings, href: schoolHref(school) }));
---
<Layout title="Confronta le scuole" active="confronto" description="Confronta fino a tre nidi, servizi 0–3 e scuole dell’infanzia di Milano: orari, costi, visite e informazioni da verificare.">
  <div class="comparison-page">
    <PageIntro accent="scuole" title="Confronta le scuole" eyebrow="LE DIFFERENZE CHE CONTANO" description="Confronta fino a tre scuole usando gli stessi criteri. Le informazioni che mancano ti aiutano a preparare le domande per la visita." tone="iris" character="arch"/>
    <section id="compare-empty" aria-labelledby="empty-compare-title" hidden><EmptyState kind="compare"><button type="button" slot="action" class="empty-action" id="compare-start">Scegli la prima scuola <Icon name="arrow-right" size={19}/></button><a slot="secondary" class="empty-secondary" href="/famiglia/">Apri le tue scuole</a></EmptyState></section>
    <section class="compare-toolbar" aria-label="Gestisci confronto"><div><strong id="compare-count">0 di 3 scuole</strong><p id="compare-context">Scegli le scuole da mettere a confronto.</p></div><div class="compare-tools"><button class="btn btn-secondary" id="share-comparison"><Icon name="external" size={17} />Copia link</button><button class="btn btn-secondary" id="print-comparison"><Icon name="download" size={17} />Stampa</button></div></section>
    <div class="compare-selection" id="compare-selection" aria-label="Scuole selezionate"></div>
    <section class="compare-picker"><label for="compare-search">Aggiungi una scuola</label><div class="compare-search-wrap"><Icon name="search" /><input id="compare-search" type="search" placeholder="Nome, indirizzo o quartiere" autocomplete="off" aria-controls="compare-search-results" /></div><div id="compare-search-results" class="compare-search-results"></div></section>
    <div id="compare-message" role="status" class="compare-message"></div>
    <div class="compare-filter-row"><label><input type="checkbox" id="compare-differences"/> Mostra solo le differenze nei dati</label><span id="compare-criteria-count" role="status"></span></div>
    <section id="compare-board" class="compare-board" aria-label="Confronto per criterio"></section>
    <noscript><p class="notice">Il confronto richiede JavaScript. Puoi consultare le <a href="/metodo/#catalogo">schede delle singole scuole</a>, complete di dati e fonti.</p></noscript>
    <div class="compare-closing"><Icon name="users" size={24} /><div><h2>E dopo la visita?</h2><p>Nel taccuino puoi raccogliere domande e punti di vista diversi. Gli appunti restano nel browser, oppure nello spazio condiviso se lo hai attivato, e non sono inclusi nel link del confronto.</p><a class="btn btn-secondary" href="/famiglia/">Apri il taccuino <Icon name="arrow-right" size={17} /></a></div></div>
  </div>
  <script id="comparison-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script>import '../scripts/compare';</script>
</Layout>
